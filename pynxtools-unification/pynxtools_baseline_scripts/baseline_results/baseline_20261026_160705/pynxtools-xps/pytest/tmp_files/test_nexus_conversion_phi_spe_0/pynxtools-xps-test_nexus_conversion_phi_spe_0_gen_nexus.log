      FIELD /Su1s/instrument/electronanalyzer/slow_axes  shape=()  dtype=object
        Value     : energy
        Concept   : NXmpes/ENTRY/INSTRUMENT/ELECTRONANALYZER/slow_axes  [RECOMMENDED]
        Dims      : nsa
        Inheritance:
          NXmpes/ENTRY/INSTRUMENT/ELECTRONANALYZER/slow_axes
          NXelectronanalyzer/slow_axes
