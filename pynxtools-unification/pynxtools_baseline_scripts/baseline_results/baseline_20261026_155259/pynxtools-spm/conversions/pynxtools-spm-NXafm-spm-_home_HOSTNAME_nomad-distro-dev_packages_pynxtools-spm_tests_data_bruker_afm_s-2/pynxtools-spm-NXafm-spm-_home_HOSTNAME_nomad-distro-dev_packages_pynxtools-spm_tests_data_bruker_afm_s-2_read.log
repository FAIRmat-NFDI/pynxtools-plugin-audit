                    data:NXdata @signal = "data" @axes = ["x_set", "y_set", "."] # default axes for
                    all three dimensions @x_encoder_indices = [0, 1] @y_encoder_indices = 1 # or [1]
                    data: float[10,7,1024] x_encoder: float[11,7] # coordinates along the first and
